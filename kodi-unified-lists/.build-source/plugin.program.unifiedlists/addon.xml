<?xml version='1.0' encoding='utf-8'?>
 <addon id="plugin.program.unifiedlists" name="Unified Local List Manager" version="0.7.15" provider-name="Kodi Unified Lists">
 <requires><import addon="xbmc.python" version="3.0.0" /></requires>
 <extension point="xbmc.python.pluginsource" library="default.py"><provides>video</provides></extension>
 <extension point="xbmc.python.script" library="context_actions.py" />
 <extension point="xbmc.service" library="resume_service.py" start="startup" />
 <extension point="kodi.context.item">
  <menu id="kodi.core.main">
   <item library="context_actions.py">
    <label>Save to Unified List</label>
    <visible>String.StartsWith(ListItem.Path,plugin://plugin.video.umbrella/) + [String.IsEqual(ListItem.dbtype,episode) | String.IsEqual(ListItem.dbtype,movie) | String.IsEqual(ListItem.dbtype,tvshow)]</visible>
   </item>
  </menu>
 </extension>
 <extension point="xbmc.addon.metadata"><summary lang="en_GB">Local lists, app spotlights and icons</summary><description lang="en_GB">Provides Android app shortcuts with per-app video spotlights, local Watch Later and favourites, UK certificate icons, and navigation icons.</description><platform>all</platform><license>MIT (code; see bundled artwork notices)</license></extension>
</addon>
