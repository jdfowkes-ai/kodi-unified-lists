<addons>
  <addon id="plugin.program.unifiedlists"
         name="Unified Local List Manager"
         version="0.2.4"
         provider-name="Kodi Unified Lists">

    <requires>
      <import addon="xbmc.python" version="3.0.0"/>
    </requires>

    <extension point="xbmc.python.pluginsource"
               library="default.py">
      <provides>executable</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Local watchlists for Kodi</summary>
      <description lang="en_GB">Manage Start Watching, Watch Later and Favourites with Kodi Library browsing.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>

  </addon>
</addons>
