<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="plugin.program.unifiedlists" name="Unified Local List Manager" version="0.5.0" provider-name="Kodi Unified Lists">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.python.script" library="context_actions.py" />
    <extension point="kodi.context.item">
      <menu id="kodi.core.main">
        <item library="context_actions.py">
          <label>Unified Lists</label>
          <visible>String.StartsWith(ListItem.Path,plugin://plugin.video.umbrella/)</visible>
        </item>
      </menu>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Local playback progress and watch lists for Kodi</summary>
      <description lang="en_GB">Uses Kodi Video Library STRM entries and native resume points for Continue Watching. Watch Later and Favourites remain local lists, and Umbrella handles library STRM creation and playback.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
</addons>
